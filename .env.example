KREIN_SMTP_HOST=smtp.gmail.com
KREIN_SMTP_PORT=587
KREIN_SMTP_FROM=
KREIN_SMTP_USERNAME=
KREIN_SMTP_PASSWORD=
KREIN_SMTP_STARTTLS=1
KREIN_SMTP_SSL=0
# The name shown as the sender (empty = the software's name, as set in the developer console)
KREIN_SMTP_FROM_NAME=
# Optional: invoices and payment reminders from their own address (for example facturen@pandtbeheer.nl), on the same
# mail server. Invitations, password resets and notices keep coming from KREIN_SMTP_FROM (for example beheer@).
# Leave the username and password empty to log in with the ones above.
KREIN_SMTP_INVOICE_FROM=
KREIN_SMTP_INVOICE_USERNAME=
KREIN_SMTP_INVOICE_PASSWORD=
KREIN_PUBLIC_URL=http://127.0.0.1:8000
# Sign people out after this many minutes without activity (0 = never; a sign-in lasts 24 hours at most)
KREIN_IDLE_MINUTES=30
OPENROUTER_API_KEY=
KREIN_OPENROUTER_MODEL=openai/gpt-oss-20b

KREIN_BOOTSTRAP_DEVELOPER_EMAIL=
KREIN_BOOTSTRAP_DEVELOPER_PASSWORD=
KREIN_BOOTSTRAP_DEVELOPER_NAME=
KREIN_BOOTSTRAP_COMPANY_NAME=Krein Property Management

# PostgreSQL (Cloud SQL) instead of the SQLite file data/krein.db, for example
# postgresql://krein:<password>@/krein?host=/cloudsql/<project>:europe-west4:<instance>   (empty = SQLite)
DATABASE_URL=

# The company website (folder website/). On these domains only the website answers, never the software,
# for example pandtbeheer.nl,www.pandtbeheer.nl (empty = no website; it can always be previewed at /site/)
KREIN_WEBSITE_HOSTS=
# The company that receives the website's registrations (empty = the first company)
KREIN_WEBSITE_COMPANY_ID=
# The website as its own service (pandt-website, app/website_service.py): a long random key, the same on the software
# and on the website service; the website passes the form on with it (empty = the relay is off). At least 32 characters.
KREIN_WEBSITE_RELAY_KEY=
# On the website service only: the software's address, for example https://krein-tenant-management-....run.app
KREIN_SOFTWARE_URL=
