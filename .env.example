# Copy this file to .env and fill in your own values. This template is committed to GitHub: never put real values here.
# Do not commit or share your real .env file.

# ---- Server only: the first login on a NEW, empty production database (used once, while the database is empty)
# It becomes the developer login (sign in at /developer). After the first start the login lives in the database;
# remove the password from the server's .env then. On your own computer use: python manage.py create-developer
KREIN_BOOTSTRAP_DEVELOPER_EMAIL=
KREIN_BOOTSTRAP_DEVELOPER_PASSWORD=
KREIN_BOOTSTRAP_DEVELOPER_NAME=
KREIN_BOOTSTRAP_COMPANY_NAME=Krein Property Management

# ---- Email (invoices, reminders, invitations): the SMTP details supplied by your email provider
KREIN_SMTP_HOST=
KREIN_SMTP_PORT=587
KREIN_SMTP_FROM=
KREIN_SMTP_USERNAME=
KREIN_SMTP_PASSWORD=
KREIN_SMTP_STARTTLS=1
KREIN_SMTP_SSL=0
KREIN_PUBLIC_URL=http://127.0.0.1:8000

# Help assistant (chat bubble). Free key: https://aistudio.google.com/apikey
# Leave empty to use the built-in keyword guide instead.
GROQ_API_KEY=
KREIN_GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
# Optional. The default alias always points at Google's newest Flash model.
KREIN_GEMINI_MODEL=gemini-flash-latest

# The timezone whose date Krein shows (servers often run on UTC). Leave empty to use this computer's own date.
KREIN_TIMEZONE=

# Largest video a tenant may attach to a repair or request, in MB (default 50, at most 500)
# KREIN_MAX_VIDEO_MB=50

# Automatic bank statements through Ponto (optional, read-only). Leave empty to keep uploading statements by hand.
# Create an integration in the Ponto dashboard (Ponto Connect) with redirect URL <KREIN_PUBLIC_URL>/api/ponto/callback.
KREIN_PONTO_CLIENT_ID=
KREIN_PONTO_CLIENT_SECRET=
# 1 while testing with Ponto's sandbox banks, 0 for your real bank accounts
KREIN_PONTO_SANDBOX=1
# Paths to the certificate and private key Ponto gives for the integration, if it asks for them (and the key's password)
KREIN_PONTO_CERT=
KREIN_PONTO_KEY=
KREIN_PONTO_KEY_PASSWORD=
# How often Krein looks for new payments, in minutes (15-1440)
KREIN_PONTO_SYNC_MINUTES=60
